+static void ParseLazpyOptions(void) {
+    Settings::values.deterministic_async_operations =
+        LibRetro::FetchVariable(config::system::deterministic_async_operations, config::disabled) ==
+        config::enabled;
+    Settings::values.async_fs_operations =
+        LibRetro::FetchVariable(config::system::async_fs_operations, config::enabled) ==
+        config::enabled;
+    Settings::values.instant_debug_log =
+        LibRetro::FetchVariable(config::system::instant_debug_log, config::disabled) ==
+        config::enabled;
+    Settings::values.init_clock =
+        LibRetro::FetchVariable(config::system::init_clock, "SystemTime") == "FixedTime"
+            ? Settings::InitClock::FixedTime
+            : Settings::InitClock::SystemTime;
+    Settings::values.init_ticks_type =
+        LibRetro::FetchVariable(config::system::init_ticks_type, "Random") == "Fixed"
+            ? Settings::InitTicks::Fixed
+            : Settings::InitTicks::Random;
+    // init_ticks_override stays at its default of 0.
+    unsigned long long init_time = 946681277ULL;
+    try {
+        const std::string text = LibRetro::FetchVariable(config::system::init_time, "946681277");
+        // A leading digit is required: stoull would accept "-1" (wraps) and leading spaces.
+        if (!text.empty() && text[0] >= '0' && text[0] <= '9') {
+            init_time = std::stoull(text);
+        }
+    } catch (const std::exception&) {
+        init_time = 946681277ULL;
     }
+    Settings::values.init_time = init_time;
 }
 
