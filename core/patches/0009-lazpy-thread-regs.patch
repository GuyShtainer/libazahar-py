+// libazahar-py: one guest thread's registers. Plain C, ten little-endian u32 fields, 40 bytes.
+struct lazpy_thread {
+    uint32_t tid;
+    uint32_t pid;      // 0xFFFFFFFF when the thread has no owner process
+    uint32_t status;   // Kernel::ThreadStatus as a number
+    uint32_t core;     // the core whose thread list holds it
+    uint32_t priority; // current priority
+    uint32_t flags;    // bit 0: the current thread of its core (registers from the live CPU)
+    uint32_t pc;
+    uint32_t lr;
+    uint32_t sp;
+    uint32_t cpsr;
+};
+static_assert(sizeof(lazpy_thread) == 40, "lazpy_thread is 40 bytes");
+
+// Every guest thread on every core: the current thread of a core from the live CPU, every other thread from its
+// saved context. Call only between frames. *count gets the total even when it exceeds max (retry with a larger
+// buffer); min(total, max) records are written. 0 ok; -1 not running; -3 bad arguments.
+extern "C" int lazpy_threads(lazpy_thread* out, uint32_t max, uint32_t* count) {
+    try {
+        if (count == nullptr || (out == nullptr && max != 0)) {
+            return -3;
+        }
+        *count = 0;
+        Core::System& system = Core::System::GetInstance();
+        if (!system.IsPoweredOn()) {
+            return -1;
+        }
+        uint32_t total = 0;
+        for (uint32_t core = 0; core < system.GetNumCores(); core++) {
+            const Kernel::ThreadManager& manager = system.Kernel().GetThreadManager(core);
+            const Kernel::Thread* current = manager.GetCurrentThread();
+            for (const auto& thread : manager.GetThreadList()) {
+                if (thread == nullptr) {
+                    continue;
+                }
+                if (total < max) {
+                    lazpy_thread& rec = out[total];
+                    const auto owner = thread->owner_process.lock();
+                    rec.tid = thread->thread_id;
+                    rec.pid = owner ? owner->process_id : 0xFFFFFFFFu;
+                    rec.status = static_cast<uint32_t>(thread->status);
+                    rec.core = core;
+                    rec.priority = thread->current_priority;
+                    // the current thread's saved context is stale: copy the live CPU's (no side effects)
+                    Core::ARM_Interface::ThreadContext live{};
+                    const bool is_current = thread.get() == current;
+                    if (is_current) {
+                        system.GetCore(core).SaveContext(live);
+                    }
+                    const Core::ARM_Interface::ThreadContext& ctx = is_current ? live : thread->context;
+                    rec.flags = is_current ? 1u : 0u;
+                    rec.pc = ctx.GetProgramCounter();
+                    rec.lr = ctx.GetLinkRegister();
+                    rec.sp = ctx.GetStackPointer();
+                    rec.cpsr = ctx.cpsr;
+                }
+                total++;
+            }
+        }
+        *count = total;
+        return 0;
+    } catch (...) {
+        return -1;
+    }
+}
