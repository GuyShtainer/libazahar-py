+// Play a .ctm movie from the next boot (do_load_game also runs from retro_reset, which replays it).
+// Call after retro_load_game and before the host's context_reset: with a hardware renderer the boot happens in
+// context_reset. 0 ok; -2 file missing; -3 null path (an empty path clears the movie, 0); -4 not a movie file; -5 already booted (the
+// software renderer boots inside retro_load_game, so there it is always too late).
+extern "C" int lazpy_movie_play(const char* path) {
+    try {
+        if (path == nullptr) {
+            return -3;
+        }
+        if (path[0] == '\0') {
+            lazpy_movie_path.clear(); // an empty path clears a movie set earlier
+            return 0;
+        }
+        if (!FileUtil::Exists(path)) {
+            return -2;
+        }
+        if (emu_instance != nullptr && emu_instance->game_loaded) {
+            return -5;
+        }
+        if (Core::System::GetInstance().Movie().ValidateMovie(path) ==
+            Core::Movie::ValidationResult::Invalid) {
+            return -4;
+        }
+        lazpy_movie_path = path;
+        return 0;
+    } catch (...) {
+        return -4;
+    }
+}
